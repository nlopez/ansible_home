global_defs {
    enable_script_security
}

vrrp_script check_haproxy {
    script "pidof haproxy"
    interval 2
    weight 2
}

vrrp_instance vips {
    state BACKUP
    interface {{ kubernetes_keepalived_interface }}
    virtual_router_id 1
    priority 100
    advert_int 1
    nopreempt
    virtual_ipaddress {
        {{ kubernetes_vip }}
    }
    track_script {
        check_haproxy
    }
}
