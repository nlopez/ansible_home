server {
    listen 80;
    listen [::]:80;
    server_name {{ technitium_proxy_hostname }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ technitium_proxy_hostname }};

    ssl_certificate {{ technitium_proxy_lego_dir }}/certificates/{{ technitium_proxy_hostname }}.crt;
    ssl_certificate_key {{ technitium_proxy_lego_dir }}/certificates/{{ technitium_proxy_hostname }}.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass {{ technitium_proxy_upstream }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
