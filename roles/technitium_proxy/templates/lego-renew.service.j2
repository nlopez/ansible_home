[Unit]
Description=Obtain or renew the {{ technitium_proxy_hostname }} certificate
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/lego.env
ExecStart=/usr/local/bin/lego run \
    --path {{ technitium_proxy_lego_dir }} \
    --server {{ technitium_proxy_acme_server }} \
    --email {{ technitium_proxy_acme_email }} \
    --accept-tos \
    --domains {{ technitium_proxy_hostname }} \
    --dns cloudflare \
    --dns.propagation.wait {{ technitium_proxy_dns_propagation_wait }} \
    --profile {{ technitium_proxy_acme_profile }} \
    --renew-days {{ technitium_proxy_renew_days }} \
    --deploy-hook "/usr/bin/systemctl reload-or-try-restart nginx.service"
